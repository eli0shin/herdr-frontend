#!/usr/bin/env bash
# Sets the six GitHub Actions secrets the release job signs and notarizes with (docs/release.md
# "Signing"), on eli0shin/herdr-frontend:
#
#   scripts/bootstrap-release-secrets                 export the Developer ID Application identity
#                                                     from your keychain
#   scripts/bootstrap-release-secrets <file.p12>      use a .p12 you already exported
#   scripts/bootstrap-release-secrets --repo <owner/name> [<file.p12>]
#
# It asks for the .p12's password, your Apple ID, an app-specific password and your team ID, says
# where to get each, then runs `gh secret set` for each secret. Everything stays in memory: it
# writes nothing to disk, and the values reach gh on stdin, never on a command line. Run it again
# any time (a renewed certificate, a new app-specific password): it sets all six again.
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo 'bootstrap-release-secrets needs macOS.' >&2; exit 1; }

repo=eli0shin/herdr-frontend
p12=
while (($#)); do
    case $1 in
        --repo) repo=${2:?--repo needs owner/name}; shift 2 ;;
        -h | --help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) echo "bootstrap-release-secrets: unknown option $1" >&2; exit 2 ;;
        *) p12=$1; shift ;;
    esac
done

fail() {
    echo "bootstrap-release-secrets: $*" >&2
    exit 1
}
say() { printf '%s\n' "$*" >&2; }
# ask <variable> <prompt> [default]
ask() {
    local answer
    read -r -p "$2${3:+ [$3]}: " answer </dev/tty
    printf -v "$1" '%s' "${answer:-${3:-}}"
}
# ask_secret <variable> <prompt>
ask_secret() {
    local answer
    read -r -s -p "$2: " answer </dev/tty
    echo >&2
    printf -v "$1" '%s' "$answer"
}

command -v gh >/dev/null || fail 'needs the GitHub CLI (brew install gh)'
gh auth status >/dev/null 2>&1 || fail 'gh is not signed in: run "gh auth login" first'
gh repo view "$repo" --json name >/dev/null || fail "gh can't see $repo"

p12_password='' team_id='' apple_id='' app_password='' confirm=''

# --- The certificate ---------------------------------------------------------------------------

if [[ -n $p12 ]]; then
    [[ -f $p12 ]] || fail "no such file: $p12"
    ask_secret p12_password "Password of $p12"
    p12_base64=$(base64 <"$p12")
else
    identities=$(security find-identity -v -p codesigning | sed -n 's/^ *[0-9]*) \([0-9A-F]\{40\}\) "\(Developer ID Application: .*\)"$/\1 \2/p')
    if [[ -z $identities ]]; then
        say 'No valid "Developer ID Application" identity in your keychain. Create one, then run this again:'
        say '  Xcode > Settings > Accounts > your team > Manage Certificates > + > Developer ID Application'
        say '  (or https://developer.apple.com/account/resources/certificates/add, then open the .cer).'
        say 'Or export one from Keychain Access as a .p12 and pass its path.'
        exit 1
    fi
    count=$(wc -l <<<"$identities" | tr -d ' ')
    choice=1
    if ((count > 1)); then
        say 'Developer ID Application identities in your keychain:'
        nl -w2 -s') ' <<<"$identities" | sed -E 's/ [0-9A-F]{40} / /' >&2
        ask choice "Which one" 1
        if ! [[ $choice =~ ^[0-9]+$ ]] || ((choice < 1 || choice > count)); then fail "no identity $choice"; fi
    fi
    picked=$(sed -n "${choice}p" <<<"$identities")
    hash=${picked%% *}
    say "Exporting \"${picked#* }\" with its private key. macOS asks to allow the export: allow it."
    say 'The .p12 gets a password of its own; it is stored as DEVELOPMENT_ID_CERTIFICATE_PASSWORD.'
    ask_secret p12_password 'Password for the exported .p12 (empty: generate one)'
    [[ -n $p12_password ]] || p12_password=$(/usr/bin/openssl rand -base64 24)
    # Exports just that identity (`security export` can only export every identity in a keychain),
    # straight to base64 on stdout.
    p12_base64=$(
        IDENTITY_SHA1=$hash P12_PASSWORD=$p12_password /usr/bin/swift - <<'SWIFT'
import CryptoKit
import Foundation
import Security

let env = ProcessInfo.processInfo.environment
let wanted = env["IDENTITY_SHA1"]!.uppercased()
let query: [String: Any] = [
    kSecClass as String: kSecClassIdentity,
    kSecMatchLimit as String: kSecMatchLimitAll,
    kSecReturnRef as String: true,
]
var found: CFTypeRef?
guard SecItemCopyMatching(query as CFDictionary, &found) == errSecSuccess,
      let identities = found as? [SecIdentity] else { exit(1) }
for identity in identities {
    var certificate: SecCertificate?
    guard SecIdentityCopyCertificate(identity, &certificate) == errSecSuccess, let certificate else { continue }
    let der = SecCertificateCopyData(certificate) as Data
    let sha1 = Insecure.SHA1.hash(data: der).map { String(format: "%02X", $0) }.joined()
    guard sha1 == wanted else { continue }
    var parameters = SecItemImportExportKeyParameters()
    parameters.version = UInt32(SEC_KEY_IMPORT_EXPORT_PARAMS_VERSION)
    parameters.passphrase = Unmanaged.passUnretained(env["P12_PASSWORD"]! as CFString)
    var exported: CFData?
    let status = SecItemExport(identity, .formatPKCS12, [], &parameters, &exported)
    guard status == errSecSuccess, let exported else {
        FileHandle.standardError.write("SecItemExport failed: \(status)\n".data(using: .utf8)!)
        exit(1)
    }
    print((exported as Data).base64EncodedString())
    exit(0)
}
FileHandle.standardError.write("no identity with SHA-1 \(wanted)\n".data(using: .utf8)!)
exit(1)
SWIFT
    ) || fail 'the export failed'
fi

# The .p12 must open with its password and hold one certificate and its key: a .p12 with every
# identity of a keychain would put the others' keys in the secret too. macOS's own LibreSSL reads
# the algorithms macOS exports with.
pkcs12() { base64 --decode <<<"$p12_base64" | P12_PASSWORD=$p12_password /usr/bin/openssl pkcs12 -passin env:P12_PASSWORD "$@" 2>/dev/null; }
pkcs12 -noout || fail "the .p12 doesn't open with that password"
keys=$(pkcs12 -nocerts -nodes | grep -c 'BEGIN .*PRIVATE KEY' || true)
((keys == 1)) || fail "the .p12 holds $keys private keys; export just the Developer ID Application identity"
subject=$(pkcs12 -nokeys -clcerts | /usr/bin/openssl x509 -noout -subject -nameopt multiline,utf8 2>/dev/null)
identity=$(sed -n 's/^ *commonName *= *//p' <<<"$subject")
[[ $identity == "Developer ID Application: "*" ("??????????")" ]] ||
    fail "the .p12's certificate is \"$identity\", not a Developer ID Application certificate"
say "Certificate: $identity"

# --- The Apple account ---------------------------------------------------------------------------

default_team=${identity##*(}
default_team=${default_team%)}
say ''
say 'Team ID: 10 characters, on https://developer.apple.com/account under Membership details.'
say "The certificate's is $default_team."
ask team_id 'Team ID' "$default_team"
[[ $team_id =~ ^[A-Z0-9]{10}$ ]] || fail "$team_id is not a 10-character team ID"
[[ $identity == *"($team_id)" ]] || fail "the certificate belongs to another team than $team_id"

say ''
say 'Apple ID: the email you sign in to developer.apple.com with, a member of that team.'
ask apple_id 'Apple ID'
[[ $apple_id == *@* ]] || fail "$apple_id is not an Apple ID"

say ''
say 'App-specific password: https://account.apple.com (formerly appleid.apple.com) > Sign-In and'
say 'Security > App-Specific Passwords > +, named "herdr-frontend notarytool". It looks like'
say 'abcd-efgh-ijkl-mnop. Revoke it there to cut off the release job.'
ask_secret app_password 'App-specific password'
[[ -n $app_password ]] || fail 'no app-specific password'

# --- The secrets ---------------------------------------------------------------------------------

say ''
say "Setting on $repo:"
say "  DEVELOPMENT_ID_CERTIFICATE_BASE64    the .p12 ($identity)"
say '  DEVELOPMENT_ID_CERTIFICATE_PASSWORD  its password'
say "  DEVELOPER_ID_APPLICATION_IDENTITY    $identity"
say "  APPLE_TEAM_ID                        $team_id"
say "  NOTARY_APPLE_ID                      $apple_id"
say '  NOTARY_APP_SPECIFIC_PASSWORD         the app-specific password'
ask confirm 'Set them? (y/N)'
[[ $confirm == [yY]* ]] || fail 'nothing set'

set_secret() { printf '%s' "$2" | gh secret set "$1" --app actions --repo "$repo"; }
set_secret DEVELOPMENT_ID_CERTIFICATE_BASE64 "$p12_base64"
set_secret DEVELOPMENT_ID_CERTIFICATE_PASSWORD "$p12_password"
set_secret DEVELOPER_ID_APPLICATION_IDENTITY "$identity"
set_secret APPLE_TEAM_ID "$team_id"
set_secret NOTARY_APPLE_ID "$apple_id"
set_secret NOTARY_APP_SPECIFIC_PASSWORD "$app_password"

say ''
gh secret list --app actions --repo "$repo" >&2
say ''
say 'Done. The next release is signed and notarized. To redo an existing release with them:'
say "  gh workflow run release-artifacts.yml --repo $repo -f tag=v<version>"
