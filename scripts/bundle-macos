#!/usr/bin/env bash
# Builds herdr-frontend.app: the release binary, the icon, an Info.plist, LICENSE and
# THIRD-PARTY-NOTICES.md with the license files it links to, signed ad hoc. Prints the bundle's
# path. `scripts/install-macos` installs it; `scripts/release-macos` signs and packages it.
#
#   scripts/bundle-macos               this Mac's architecture: target/release/herdr-frontend.app
#   scripts/bundle-macos --universal   Apple silicon and Intel in one binary:
#                                      target/universal-apple-darwin/release/herdr-frontend.app
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo 'bundle-macos needs macOS.' >&2; exit 1; }
cd "$(dirname "$0")/.."

universal=0
case "${1:-}" in
    '') ;;
    --universal) universal=1 ;;
    *) echo "usage: scripts/bundle-macos [--universal]" >&2; exit 2 ;;
esac

if ((universal)); then
    # Each architecture on its own, then one binary from both. libghostty-vt's xcframework slice is
    # already universal; ghostty-vt-sys thins it to each target.
    targets=(aarch64-apple-darwin x86_64-apple-darwin)
    out=target/universal-apple-darwin/release
    rustup target add "${targets[@]}" >&2
    for target in "${targets[@]}"; do
        cargo build --release --locked --target "$target" -p herdr-frontend --bin herdr-frontend >&2
    done
    mkdir -p "$out"
    lipo -create -output "$out/herdr-frontend" \
        "target/${targets[0]}/release/herdr-frontend" "target/${targets[1]}/release/herdr-frontend"
    for arch in arm64 x86_64; do lipo "$out/herdr-frontend" -verify_arch "$arch"; done
else
    out=target/release
    cargo build --release --locked -p herdr-frontend --bin herdr-frontend >&2
fi

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
[[ -n $version ]] || { echo 'bundle-macos: no version in Cargo.toml' >&2; exit 1; }

app=$out/herdr-frontend.app
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$out/herdr-frontend" "$app/Contents/MacOS/herdr-frontend"
cp assets/icon/herdr-frontend.icns "$app/Contents/Resources/herdr-frontend.icns"

# The licenses ship with the app: LICENSE, THIRD-PARTY-NOTICES.md, and every local file the notices
# link to, at the same relative paths, so the notices' links resolve inside Resources too.
cp LICENSE THIRD-PARTY-NOTICES.md "$app/Contents/Resources/"
while IFS= read -r link; do
    case $link in
        # Not shipped: web links, and the licenses of files only the tests use.
        http://* | https://* | mailto:* | '#'* | crates/*/tests/*) continue ;;
    esac
    link=${link%%#*}
    link=${link%/}
    [[ -e $link ]] || { echo "bundle-macos: THIRD-PARTY-NOTICES.md links to $link, which is missing" >&2; exit 1; }
    mkdir -p "$app/Contents/Resources/$(dirname "$link")"
    cp -R "$link" "$app/Contents/Resources/$(dirname "$link")/"
done < <(grep -oE '\]\([^)]+\)' THIRD-PARTY-NOTICES.md | sed -E 's/^\]\((.*)\)$/\1/' | sort -u)

# Its own identifier and name, so it sits beside Herdr.app (dev.herdr.app) and never replaces it.
# No usage descriptions: terminal programs run under herdr-core, not this process.
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>herdr-frontend</string>
    <key>CFBundleIdentifier</key><string>dev.herdr.frontend</string>
    <key>CFBundleName</key><string>herdr-frontend</string>
    <key>CFBundleDisplayName</key><string>herdr-frontend</string>
    <key>CFBundleIconFile</key><string>herdr-frontend</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST
plutil -lint "$app/Contents/Info.plist" >&2

# Ad hoc: no Developer ID, so Gatekeeper would stop a downloaded copy, but a local build runs.
codesign --force --sign - "$app"
codesign --verify --strict "$app"
echo "$app"
