#!/usr/bin/env bash
# The renderer's pixel diff against Ghostty.app (docs/research/renderer-gates.md): for each screen,
# capture Ghostty drawing it (scripts/ghostty-capture), draw the same bytes at the same grid with
# herdr-frontend's renderer (`--snap --scene screen-file`), and compare them cell by cell
# (`pixel-diff`). Results go to target/ghostty/<screen>/: ghostty.png, ours.png, diff.png and
# report.md.
#
#   scripts/ghostty-diff [--reuse] [SCREEN...]   screens: colors boxes nvim nvim-checklist styles
#                                                images (default: all)
#
# `--reuse` keeps each screen's last Ghostty capture and only draws and compares ours again, so a
# renderer fix can be checked without opening Ghostty.
#
# Opens a Ghostty window for a few seconds per screen. macOS on a 2x display, JetBrains Mono 14 pt
# (a 17 x 37 px cell), except `styles`: regular, bold, italic and bold italic in Operator Mono
# Book at 18.7 pt (a 21 x 45 px cell), each style the face its style name picks, from
# fixtures/styles.ghostty for Ghostty and fixtures/styles.json for ours. It needs Operator Mono
# installed. `images` is `kitten icat`'s kitty graphics recording (crates/terminal/tests/images.rs),
# reported by image as well.
set -euo pipefail
cd "$(dirname "$0")/.."

reuse=false
if [ "${1:-}" = "--reuse" ]; then
    reuse=true
    shift
fi
screens=("$@")
[ ${#screens[@]} -gt 0 ] || screens=(colors boxes nvim nvim-checklist styles images)

cargo build --quiet -p herdr-frontend --bins
bin=target/debug
fixtures=$PWD/crates/app/fixtures
streams=$PWD/crates/terminal/tests/streams

for screen in "${screens[@]}"; do
    out=target/ghostty/$screen
    mkdir -p "$out"
    # The cell in device pixels, and the settings ours draws with (none: Ghostty's defaults).
    cell_w=17 cell_h=37 settings=""
    if [ "$screen" = styles ]; then
        cell_w=21 cell_h=45 settings=$fixtures/styles.json
    fi
    if $reuse; then
        [ -s "$out/ghostty.png" ] || { echo "ghostty-diff: no capture of $screen to reuse" >&2; exit 2; }
    else
        case $screen in
            colors | boxes)
                scripts/ghostty-capture "$out" -- cat "$fixtures/$screen.bin"
                ;;
            images)
                scripts/ghostty-capture "$out" -- cat "$streams/kitty-icat.bin"
                ;;
            styles)
                scripts/ghostty-capture "$out" --config "$fixtures/styles.ghostty" -- \
                    cat "$fixtures/styles.bin"
                ;;
            nvim)
                # Neovim with no user config, in a scratch home, splits and a visual selection as in
                # fixtures/nvim-splits.bin, but at Ghostty's grid.
                scratch=$(mktemp -d)
                cp "$streams/meters.py" "$streams/sample.txt" "$streams/pager.txt" "$scratch/"
                printf ':set number cursorline\r:vsplit sample.txt\r:split pager.txt\r:set number\r\027l9Gvjj$' >"$scratch/keys"
                scripts/ghostty-capture "$out" --keep 3 -- /usr/bin/env -i HOME="$scratch" \
                    TERM=xterm-256color PATH=/opt/homebrew/bin:/usr/bin:/bin LANG=en_US.UTF-8 \
                    /bin/sh -c "cd '$scratch' && exec nvim --clean --cmd 'set termguicolors' -s keys meters.py"
                ;;
            nvim-checklist)
                # fixtures/nvim-checklist.lua with Ghostty's own terminfo, so Neovim sends undercurls,
                # with the cmdline typed as in fixtures/nvim-checklist.bin.
                scratch=$(mktemp -d)
                printf ':%%s/nam/name' >"$scratch/keys"
                scripts/ghostty-capture "$out" --keep 3 -- /usr/bin/env -i HOME="$scratch" \
                    TERM=xterm-ghostty TERMINFO=/Applications/Ghostty.app/Contents/Resources/terminfo \
                    PATH=/opt/homebrew/bin:/usr/bin:/bin LANG=en_US.UTF-8 \
                    /bin/sh -c "cd '$scratch' && exec nvim -n -i NONE -u '$fixtures/nvim-checklist.lua' -s keys"
                ;;
            *)
                echo "ghostty-diff: no screen named $screen" >&2
                exit 2
                ;;
        esac
    fi
    read -r rows cols <"$out/grid"
    # The checklist's items, each reported on its own: the vsplit's separator (Neovim gives the
    # left window `cols / 2`), the float with its border, the statusline and the cmdline.
    regions=()
    if [ "$screen" = nvim-checklist ]; then
        regions=(--region "split=$((cols / 2)),0,1,$((rows - 2))" --region float=12,9,30,5
            --region statusline=0,-2,$cols,1 --region cmdline=0,-1,$cols,1)
    fi
    # Each image's cells (streams/kitty-images.py `show`): in every layer, scaled by icat, as
    # unicode placeholders, and the row by hand.
    if [ "$screen" = images ]; then
        regions=(--region photo=0,1,8,2 --region scaled=10,1,16,4 --region below-text=28,1,20,3
            --region below-background=52,1,20,3 --region above-text=12,6,4,1 --region dots=46,6,2,1
            --region placeholders=0,10,36,4 --region by-hand=0,21,12,1)
    fi
    # Each style's four lines of text (fixtures/make.py `styles`), after their labels.
    if [ "$screen" = styles ]; then
        regions=(--region regular=13,2,52,4 --region bold=13,7,52,4 --region italic=13,12,52,4
            --region bold-italic=13,17,52,4)
    fi
    # The snap's size in points: the grid at half a cell's pixels a cell, rounded up.
    width=$(( (cols * cell_w + 1) / 2 ))
    height=$(( (rows * cell_h + 1) / 2 ))
    HERDR_FRONTEND_SCREEN="$out/screen.bin" HERDR_FRONTEND_GRID="${cols}x${rows}" \
        HERDR_FRONTEND_SETTINGS="$settings" \
        "$bin/herdr-frontend" --snap "$out/ours.png" --scene screen-file \
        --size "${width}x${height}" --scale 2 >/dev/null 2>&1
    HERDR_FRONTEND_SETTINGS="$settings" \
        "$bin/pixel-diff" ${regions[@]+"${regions[@]}"} "$out/ghostty.png" "$out/ours.png" \
        "$out/screen.bin" "$cols" "$rows" "$out/diff.png" | tee "$out/report.md"
    echo
done
