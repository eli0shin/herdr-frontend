{
  "title": "Agent navigation and jump",
  "inventory": "§7",
  "notes": "Next/previous agent in the list's order, numbered agents and the Ctrl+; jump bar, also with the sidebar hidden.",
  "steps": [
    {"name": "next agent", "keys": "cmd-]", "herdr-app": {"do": "agent.next"}},
    {"name": "next agent again", "keys": "ctrl-g j", "herdr-app": {"do": "agent.next"}},
    {"name": "previous agent", "keys": "cmd-[", "herdr-app": {"do": "agent.prev"}},
    {"name": "agent 2", "keys": "ctrl-g shift-2", "herdr-app": {"do": "navigator-status.agent-2"}},
    {"name": "jump bar", "keys": "ctrl-;", "herdr-app": {"do": "mod.open", "args": {"name": "agent-jump"}}},
    {"name": "leave the jump bar", "keys": "escape", "herdr-app": {"do": "overlay.close"}},
    {"name": "hide the sidebar", "keys": "cmd-b", "herdr-app": {"do": "layout.toggle", "args": {"id": "sidebar"}}},
    {"name": "jump bar shows the sidebar", "keys": "ctrl-;", "herdr-app": {"do": "mod.open", "args": {"name": "agent-jump"}}},
    {"name": "jump to row 1, the sidebar hides again", "keys": "1", "herdr-app": {"skip": "keys go to herdr-frontend only"}}
  ]
}
