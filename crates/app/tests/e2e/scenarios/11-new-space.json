{
  "title": "New space and worktree flows",
  "inventory": "§11",
  "notes": "The Cmd+N folder picker lists the focused folder, then zoxide's and repos' folders as the isolated core's machine reports them (read only).",
  "steps": [
    {"name": "new space picker", "keys": "cmd-n", "herdr-app": {"do": "mod.open", "args": {"name": "new-space"}}, "wait": 0.5},
    {"name": "type a path", "type": "/tmp/", "herdr-app": {"skip": "typing goes to herdr-frontend only"}},
    {"name": "close it", "keys": "escape", "herdr-app": {"do": "overlay.close"}},
    {"name": "new space in a folder", "do": "space.new", "args": {"folder": "{{folder:api}}"}}
  ]
}
