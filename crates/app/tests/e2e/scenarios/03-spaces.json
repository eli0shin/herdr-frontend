{
  "title": "Spaces",
  "inventory": "§3",
  "notes": "Selecting by number, the Ctrl+G S space picker, renaming and closing.",
  "steps": [
    {"name": "select space 2", "do": "space.select", "args": {"index": 2}},
    {"name": "ctrl-3 selects space 3", "keys": "ctrl-3", "herdr-app": {"do": "space.select", "args": {"index": 3}}},
    {"name": "next space", "keys": "cmd-alt-]", "herdr-app": {"do": "space.next"}},
    {"name": "space picker", "keys": "ctrl-g s", "herdr-app": {"do": "mod.open", "args": {"name": "space-picker"}}},
    {
      "name": "type in the picker",
      "type": "not",
      "herdr-app": {"skip": "typing goes to herdr-frontend only"}
    },
    {"name": "close the picker", "keys": "escape", "herdr-app": {"do": "overlay.close"}},
    {"name": "rename a space", "do": "space.rename", "args": {"id": "{{sp:api}}", "name": "api server"}},
    {
      "name": "ask before closing a space",
      "note": "ctrl-g x opens the confirm dialog; a script's space.close never asks.",
      "keys": "ctrl-g x",
      "herdr-app": {"skip": "space.close from a script fails instead of asking"}
    },
    {"name": "cancel", "keys": "escape", "herdr-app": {"skip": "no dialog open"}},
    {"name": "close a space", "do": "space.close", "args": {"id": "{{sp:notes}}", "confirmed": true}}
  ]
}
